{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Wiki",
  "version": "1.0.0",
  "identifier": "app.personalwiki.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build:only",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Wiki",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "Personal Wiki",
    "category": "Productivity",
    "shortDescription": "Personal Wiki — قاعدة معرفتك للأوامر",
    "longDescription": "قاعدة معرفة محلية للأوامر والشروحات والأمثلة لأدوات سطر الأوامر وأدوات الذكاء الاصطناعي.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"]
      }
    }
  },
  "plugins": {}
}
