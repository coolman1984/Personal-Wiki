      "accentKey": "orange",
      "examples": [
        {
          "code": "git switch main",
          "title": "الانتقال إلى الفرع الرئيسي"
        },
        {
          "code": "git switch -c feature/login",
          "title": "إنشاء فرع جديد والانتقال إليه"
        },
        {
          "code": "git switch --detach <start-point>",
          "title": "فصل شجرة العمل عن أي فرع"
